# SSH connection to Lightning AI Studio
LIGHTNING_REMOTE_USER=your_lightning_ssh_username
LIGHTNING_REMOTE_HOST=ssh.lightning.ai
LIGHTNING_KEY_PATH=$HOME/.ssh/id_ed25519

# Remote project directory on Lightning
LIGHTNING_REMOTE_DIR=/home/zeus/content/sih-model-training

# Remote Python binary (inside the correct conda env)
LIGHTNING_PYTHON_BIN=/home/zeus/miniconda3/envs/cloudspace/bin/python

# (Optional) Lightning CLI studio name for start/stop commands
LIGHTNING_STUDIO_NAME=your-studio-name
LIGHTNING_TEAMSPACE=your-teamspace-name
