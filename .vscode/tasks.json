      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    },
    {
      "label": "SIH: First-Time Data Sync to Lightning",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .vscode/sync_and_run.ps1 -SyncData -preflight",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    },
    {
      "label": "SIH: Interactive SSH Terminal",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -Command \"& { $env = Get-Content configs/lightning.env | Where-Object { $_ -match '=' -and $_ -notmatch '^#' } | ForEach-Object { $p = $_ -split '=',2; [PSCustomObject]@{K=$p[0].Trim();V=$p[1].Trim() -replace '\\$HOME',$HOME} }; $u = ($env | Where-Object K -eq 'LIGHTNING_REMOTE_USER').V; $h = ($env | Where-Object K -eq 'LIGHTNING_REMOTE_HOST').V; $k = ($env | Where-Object K -eq 'LIGHTNING_KEY_PATH').V; $d = ($env | Where-Object K -eq 'LIGHTNING_REMOTE_DIR').V; ssh -o UpdateHostKeys=no -i $k -t ${u}@${h} \"cd $d && exec bash -l\" }\"",
      "presentation": { "reveal": "always", "panel": "new", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "SIH: Run Current File Directly",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .vscode/sync_and_run.ps1 -FileToRun \"${relativeFile}\"",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Local: Run Current Python File",
      "type": "shell",
      "command": "py -3 \"${file}\"",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/src"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Local: List Datasets",
      "type": "shell",
      "command": "py -3 -c \"import os; [print(f'  {d}') for d in os.listdir('data') if os.path.isdir(os.path.join('data', d))]\"",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true, "focus": true },
      "problemMatcher": []
    }
